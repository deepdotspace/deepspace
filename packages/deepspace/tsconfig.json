{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src"],
  "exclude": [
    "src/expo.ts",
    "src/__tests__/expo.test.ts",
    "src/native.ts",
    "src/native",
    "src/**/*.native.ts",
    "src/**/*.native.tsx",
    "src/__tests__/native-*.test.ts",
    "src/__tests__/native-*.test.tsx"
  ]
}
